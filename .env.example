JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
# Set to false when serving over plain HTTP (e.g. a Tailscale IP). A Secure
# cookie is discarded by the browser on http://, so login silently fails.
COOKIE_SECURE=false

# Floci / LocalStack / AWS S3 Endpoint Configuration
# Inside Docker Compose use the service name and container port: http://floci:4566
FLOCI_ENDPOINT=http://100.124.36.46:14566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Harness
HARNESS_DB=./harness.db
